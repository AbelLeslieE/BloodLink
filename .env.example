# Copy values into your deployment's secret store. Never commit real credentials.
APP_ENV=development
DATABASE_URL=sqlite:///./bloodlink.db
JWT_ALGORITHM=HS256
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Blank URLs/hosts derive localhost locally, or RENDER_EXTERNAL_URL on Render.
# Set all public custom domains in ALLOWED_HOSTS (comma-separated).
BACKEND_URL=
FRONTEND_URL=
ALLOWED_HOSTS=
PORT=8000
# PostgreSQL: verify-full for public hosts. On Render, managed dpg-* internal
# and external hosts are detected automatically and use Render's required TLS.
# Explicit modes: verify-full, render-internal, or render-managed.
DATABASE_TLS_MODE=verify-full
DATABASE_CA_FILE=
# Required only when initially creating an administrator.
DEFAULT_VOLUNTEER_USERNAME=volunteer
DEFAULT_VOLUNTEER_PASSWORD=
# SQLCipher: configure ONE key source, then convert to a new database file.
# A random 32-byte key encoded as 64 hex characters; NOT the JWT secret.
DATABASE_ENCRYPTION_KEY=
# Or an absolute path outside the repository, readable only by the app identity:
DATABASE_ENCRYPTION_KEY_FILE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
RESEND_API_KEY=
EMAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
