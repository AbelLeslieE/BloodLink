# Copy values into your deployment's secret store. Never commit real credentials.
APP_ENV=development
DATABASE_URL=sqlite:///./bloodlink.db
JWT_ALGORITHM=HS256
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Whole-blood post-donation deferral intervals. These defaults follow India's
# National Standards for Blood Centres; the responsible clinician must review
# them for the donation type and local policy before deployment.
DONOR_DEFERRAL_DAYS_MALE=90
DONOR_DEFERRAL_DAYS_FEMALE=120
DONOR_DEFERRAL_DAYS_OTHER=120
# Required dates expire at midnight after the selected day in this timezone.
REQUEST_TIMEZONE=Asia/Kolkata
# Blank URLs/hosts derive localhost locally, or RENDER_EXTERNAL_URL on Render.
# Set all public custom domains in ALLOWED_HOSTS (comma-separated).
BACKEND_URL=
FRONTEND_URL=
ALLOWED_HOSTS=
PORT=8000
# PostgreSQL: verify-full for public hosts. On Render, managed dpg-* internal
# and external hosts are detected automatically and use Render's required TLS.
# Provider URLs that already specify sslmode=require are preserved on Render.
# Explicit modes: verify-full, require, render-internal, or render-managed.
DATABASE_TLS_MODE=verify-full
DATABASE_CA_FILE=
# Required only when initially creating an administrator. Production rejects
# guessable names (volunteer, admin, ...) and passwords under 16 characters.
# Remove DEFAULT_VOLUNTEER_PASSWORD from the environment after the first boot.
DEFAULT_VOLUNTEER_USERNAME=
DEFAULT_VOLUNTEER_PASSWORD=
DEFAULT_VOLUNTEER_EMAIL=
# Proxies whose X-Forwarded-For is trusted. Blank = loopback locally, Render's
# private network on Render. Never "*".
FORWARDED_ALLOW_IPS=
# SQLCipher: configure ONE key source, then convert to a new database file.
# A random 32-byte key encoded as 64 hex characters; NOT the JWT secret.
DATABASE_ENCRYPTION_KEY=
# Or an absolute path outside the repository, readable only by the app identity:
DATABASE_ENCRYPTION_KEY_FILE=
# Technical Portal backups. Production requires a dedicated 32-byte Fernet
# key (URL-safe base64) and a persistent storage mount outside the repository.
# Generate a key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_ENCRYPTION_KEY=
BACKUP_DIRECTORY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
RESEND_API_KEY=
EMAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
